APP_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
SESSION_DAYS=30
SESSION_VERSION=1

# 金鑰輪替（平時不用設；步驟見 README「API Key 加密金鑰輪替」）
# KEY_VERSION=v2                      目前 ENCRYPTION_KEY 的版本名，未設定為 v1
# ENCRYPTION_KEY_PREVIOUS=            輪替前的 ENCRYPTION_KEY
# KEY_VERSION_PREVIOUS=v1             舊金鑰的版本名，未設定為 v0
# TAVILY_API_KEY=tvly-...
# KEYWORD_SEARCH=auto                知識庫關鍵字引擎：auto（BM25，退回二字組）/ bm25 / bigram；面板設定優先

# 供應商（沒有內建；N = 1..20，全部掃描、可跳號；也可只在設定面板新增）。說明見 README「用環境變數設定供應商」
# NAME 與 BASE_URL 必填；API_KEY 選填（自建可留空）；MODELS 是聊天模型、EMBED_MODELS 是嵌入模型（逗號分隔）
# Key 只從環境變數讀取，不寫進資料庫、不傳到瀏覽器；面板唯讀顯示「由環境變數管理」
# PROVIDER_1_NAME=Groq
# PROVIDER_1_BASE_URL=https://api.groq.com/openai/v1
# PROVIDER_1_API_KEY=gsk_...
# PROVIDER_1_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# PROVIDER_1_EMBED_MODELS=
#
# PROVIDER_2_NAME=Cloudflare Workers AI
# PROVIDER_2_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# PROVIDER_2_API_KEY=...
# PROVIDER_2_EMBED_MODELS=@cf/baai/bge-m3

# 物件儲存（Neon Object Storage，S3 相容；專案需在 aws-us-east-1/us-east-2/eu-central-1/ap-southeast-1）
# 取得方式：neon credentials create --scope storage:read --scope storage:write
# 建好 bucket 後執行：node scripts/storage-cors.mjs https://你的站.netlify.app
# STORAGE_ENDPOINT=https://br-xxx.storage.c-2.us-east-2.aws.neon.tech
# STORAGE_REGION=us-east-2
# STORAGE_BUCKET=personal-ai-files
# STORAGE_ACCESS_KEY_ID=nak_live_...
# STORAGE_SECRET_ACCESS_KEY=nsk_live_...
# MAX_UPLOAD_MB=25
