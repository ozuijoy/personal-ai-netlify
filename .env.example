APP_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
SESSION_DAYS=30
SESSION_VERSION=1
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# TAVILY_API_KEY=tvly-...

# 內建語意檢索（Cloudflare Workers AI，預設模型 @cf/baai/bge-m3，1024 維，支援中文）
# 免費額度：每帳號每天 10,000 Neurons（約 930 萬 tokens 的 bge-m3），UTC 0 點重置，整個帳號共用
# Token 需要 Workers AI 權限（Account → Workers AI → Read）
# CLOUDFLARE_ACCOUNT_ID=32 位十六進位帳號 ID
# CLOUDFLARE_AI_TOKEN=...
# EMBEDDING_MODEL=@cf/baai/bge-m3

# 物件儲存（Neon Object Storage，S3 相容；專案需在 aws-us-east-1/us-east-2/eu-central-1/ap-southeast-1）
# 取得方式：neon credentials create --scope storage:read --scope storage:write
# 建好 bucket 後執行：node scripts/storage-cors.mjs https://你的站.netlify.app
# STORAGE_ENDPOINT=https://br-xxx.storage.c-2.us-east-2.aws.neon.tech
# STORAGE_REGION=us-east-2
# STORAGE_BUCKET=personal-ai-files
# STORAGE_ACCESS_KEY_ID=nak_live_...
# STORAGE_SECRET_ACCESS_KEY=nsk_live_...
# MAX_UPLOAD_MB=25
